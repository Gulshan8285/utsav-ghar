# ==============================================================================
# UTSAV GHAR - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# APP URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DATABASE (SUPABASE / POSTGRESQL)
# Zero-config mode: If omitted, Utsav Ghar runs seamlessly using the persistent relational database engine in data/utsav_store.json
# Production Supabase PostgreSQL:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# PAYMENT GATEWAY (RAZORPAY)
# Zero-config / Sandbox mode: If omitted, sandbox simulation mode automatically handles test transactions with HMAC signature verification
# Razorpay Live / Test Credentials:
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# TRANSACTIONAL EMAIL (RESEND / SMTP)
# Optional: Configure to send live dispatch SMS and emails
EMAIL_FROM="Utsav Ghar Festive Care <orders@utsavghar.com>"
RESEND_API_KEY=re_your_resend_api_key

# ADMIN INITIAL PASSWORD / CREDENTIALS
ADMIN_INITIAL_EMAIL=admin@utsavghar.com
